# Copy to .env and fill in real values. .env is gitignored -- never commit it.

POSTGRES_DB=roomidrive
POSTGRES_USER=roomidrive
POSTGRES_PASSWORD=changeme-generate-a-real-password

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-a-real-secret

# Required to create a new household via "New household" on the login screen.
# Keeps randoms who find the public URL from bootstrapping their own household.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
BOOTSTRAP_SECRET=changeme-generate-a-real-secret

# From Cloudflare Zero Trust -> Networks -> Tunnels -> (your tunnel) -> Configure
TUNNEL_TOKEN=changeme-paste-your-cloudflare-tunnel-token
